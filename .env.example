# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。
# 也可以把这些变量写进 ~/.zshrc，效果相同。

# 模型：LiteLLM 的 "provider/model" 写法。
# openai/ 前缀表示走 OpenAI 兼容协议，配合下面的 api_base 可接任何兼容服务。
OHOPILOT_MODEL=openai/deepseek-v4-flash

# 接口地址（不要漏掉 /v1）
OHOPILOT_API_BASE=https://api.deepseek.com/v1

# 密钥。留空则回退读 DEEPSEEK_API_KEY。
OHOPILOT_API_KEY=sk-your-key-here

# 沙箱与安全
# 文件工具的工作根目录，留空表示用当前工作目录
OHOPILOT_WORKSPACE=
# 是否允许写文件（false 时写操作一律要求人工确认）
OHOPILOT_ALLOW_WRITE=true
# 命令执行超时（秒）
OHOPILOT_SHELL_TIMEOUT=60

# 服务端（可选，仅在跑 oho serve 时需要）
# OHOPILOT_HOST=127.0.0.1
# OHOPILOT_PORT=8737
