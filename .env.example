# 下面四个是必填/常用项。复制本文件为 .env 再填真值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，密钥不会进仓库。

# 模型密钥（DeepSeek 控制台申请）
OHOPILOT_API_KEY=

# 模型名与接口地址。换模型只改这两行，内核代码不动
OHOPILOT_MODEL=deepseek-v4-flash
OHOPILOT_API_BASE=https://api.deepseek.com

# 可选：下面都有默认值，需要时再放开
# OHOPILOT_WORKSPACE=/你的/工作目录
# OHOPILOT_HOME=~/.ohopilot
# OHOPILOT_ALLOW_WRITE=1
# OHOPILOT_SHELL_TIMEOUT=60
# OHOPILOT_MAX_TOOL_ROUNDS=12
# OHOPILOT_SUMMARY_AFTER=24
# OHOPILOT_SUMMARY_KEEP=8
# OHOPILOT_HOST=127.0.0.1
# OHOPILOT_PORT=8737
# OHOPILOT_APPROVAL_TIMEOUT=180
