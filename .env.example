# 下面四个是必填/常用项。复制本文件为 .env 再填真值：
#   cp .env.example .env
# .env 已被 .gitignore 排除，密钥不会进仓库。

# 模型密钥（DeepSeek 控制台申请）
OHOPILOT_API_KEY=

# 模型名与接口地址。换模型只改这两行，内核代码不动
OHOPILOT_MODEL=deepseek-v4-flash
OHOPILOT_API_BASE=https://api.deepseek.com
# 可选：模型路由（第 25 步）——滚动摘要等后台任务走这个便宜模型，不配则一律走主模型
# OHOPILOT_FAST_MODEL=deepseek-chat

# 可选：下面都有默认值，需要时再放开
# OHOPILOT_WORKSPACE=/你的/工作目录
# OHOPILOT_HOME=~/.ohopilot
# OHOPILOT_ALLOW_WRITE=1
# OHOPILOT_SHELL_TIMEOUT=60
# OHOPILOT_MAX_TOOL_ROUNDS=12
# OHOPILOT_SUMMARY_AFTER=24
# OHOPILOT_SUMMARY_KEEP=8
# OHOPILOT_HOST=127.0.0.1
# OHOPILOT_PORT=8737
# OHOPILOT_APPROVAL_TIMEOUT=180

# 网页搜索（第 19 步）：后端三选一。searxng=自建 Docker（免费，默认）；
# tavily=免费 1000 次/月（https://tavily.com 注册）；bocha=付费中文最佳（https://bochaai.com）
# OHOPILOT_SEARCH_PROVIDER=searxng
# OHOPILOT_SEARXNG_BASE_URL=http://127.0.0.1:8080
# OHOPILOT_TAVILY_API_KEY=
# OHOPILOT_BOCHA_API_KEY=

# 知识库 RAG（第 22 步）：需要先 pip install "ohopilot[rag]" 并配置 embedding。
# 任何 OpenAI 兼容 embedding 接口都行，例如硅基流动（bge-m3 有免费额度）：
#   https://api.siliconflow.cn 注册后填 OHOPILOT_EMBEDDING_API_KEY
# OHOPILOT_EMBEDDING_MODEL=openai/BAAI/bge-m3
# OHOPILOT_EMBEDDING_API_BASE=https://api.siliconflow.cn/v1
# OHOPILOT_EMBEDDING_API_KEY=
# 向量后端：sqlite-vec（默认，零服务）/ milvus（需本地 Docker 服务）
# OHOPILOT_VECTOR_BACKEND=sqlite-vec
# OHOPILOT_MILVUS_URI=http://127.0.0.1:19530
